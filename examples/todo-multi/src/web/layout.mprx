<shell class="layout" theme={resolvedTheme}>
  <header class="bar">
    <link class="brand" href={home} current="false">{site}</link>
    <theme-toggle theme={resolvedTheme} on.toggle={toggleTheme()} />
  </header>
  <div class="frame">
    <nav class="sidebar" label="Pages">
      {#each sections as s (s.id)}
        <section>
          {#if s.title != ""}<paragraph class="nav-title">{s.title}</paragraph>{/if}
          <list class="nav-list">
            {#each s.items as n (n.id)}
              <listitem><link class="nav-link" href={n.href} current={n.current}>{n.label}</link></listitem>
            {/each}
          </list>
        </section>
      {/each}
    </nav>
    <main id="content" tabindex="-1">
      <blocks items={blocks} />
      <section>
        <paragraph class="todo-title">To do</paragraph>
        <paragraph class="todo-summary">{summary}</paragraph>
        <todo-add entry={entry} on.type={setEntry($event)} on.add={addItem()} on.cancel={clearEntry()} />
        <list class="todo-list">
          {#each items as it (it.id)}
            <listitem><todo-item title={it.title} done={it.done} on.tick={setDone(it.id, $event)} on.remove={removeItem(it.id)} /></listitem>
          {/each}
        </list>
        <button class="todo-button" pressed="false" on.click={clearDone()}>Clear done</button>
      </section>
      <nav class="pager" label="Previous and next page">
        {#if prev.href != ""}<link class="pager-link" href={prev.href} current="false">{prev.label}</link>{/if}
        {#if next.href != ""}<link class="pager-link" href={next.href} current="false">{next.label}</link>{/if}
      </nav>
    </main>
  </div>
</shell>
