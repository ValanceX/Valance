<div class="signup-form">
  <h1 id="signup">Create your account</h1>
  {#if done}
    <para class="success">Welcome, {name}. Your {plan} account is ready.</para>
    <button class="again" on.click={reset()}>Start again</button>
  {:else}
    <radiogroup class="plans" label="Plan">
      <label><radio name="plan" value="free" checked={plan == "free"} on.select={setPlan($event)} />Free</label>
      <label><radio name="plan" value="pro" checked={plan == "pro"} on.select={setPlan($event)} />Pro</label>
    </radiogroup>
    <div class="field">
      <textfield value={name} label="Name" invalid={nameError != ""} describedby="name-error" placeholder="Ada Lovelace" on.change={setName($event)} on.blur={touch("name")} on.submit={submit()} on.cancel={reset()} />
      {#if nameError != ""}<para class="error" id="name-error">{nameError}</para>{/if}
    </div>
    <div class="field">
      <textfield value={email} label="Email" invalid={emailError != ""} describedby="email-error" placeholder="you@example.com" on.change={setEmail($event)} on.blur={touch("email")} on.submit={submit()} on.cancel={reset()} />
      {#if emailError != ""}<para class="error" id="email-error">{emailError}</para>{/if}
    </div>
    <div class="field">
      <textfield value={password} label="Password" kind="password" invalid={passwordError != ""} describedby="password-error" placeholder="8 characters or more" on.change={setPassword($event)} on.blur={touch("password")} on.submit={submit()} on.cancel={reset()} />
      {#if passwordError != ""}<para class="error" id="password-error">{passwordError}</para>{/if}
    </div>
    <div class="field">
      <checkbox checked={terms} label="I accept the terms" invalid={termsError != ""} describedby="terms-error" on.change={setTerms($event)} />
      {#if termsError != ""}<para class="error" id="terms-error">{termsError}</para>{/if}
    </div>
    {#if failure != ""}<para class="failure">{failure}</para>{/if}
    <button class="send" disabled={sending} on.click={submit()}>{sending ? "Creating…" : "Create account"}</button>
  {/if}
</div>
