{
  "name": "@valancex/docs-site",
  "version": "0.0.0",
  "private": true,
  "description": "A real example: a documentation site (routes, links, search, server rendering, hydration) built on the published @valancex/valance.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:smoke": "vitest run -c vitest.smoke.config.ts",
    "dev": "vite build -c vite.page.config.ts --watch",
    "build": "vite build -c vite.page.config.ts && tsc -p tsconfig.server.json && cp src/*.mprx dist/server/",
    "start": "node dist/server/serve-main.js"
  },
  "dependencies": {
    "@valancex/valance": "^0.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@valancex/mesh-compiler": "^0.9.0",
    "@valancex/mesh-runtime": "^0.9.0",
    "@valancex/nexus": "^0.10.3",
    "@valancex/port-web": "^0.3.0",
    "effect": "^3.10.0",
    "playwright": "1.56.1",
    "typescript": "^5.6.0",
    "vite": "7.3.6",
    "vitest": "^3.2.0"
  }
}
