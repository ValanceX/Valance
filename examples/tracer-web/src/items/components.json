{
  "version": 1,
  "types": {},
  "components": {
    "page":   { "props": { "title": { "type": { "kind": "string" }, "required": true } }, "events": {}, "commands": {}, "scope": {} },
    "text":   { "props": {}, "events": {}, "commands": {}, "scope": {} },
    "row":    { "props": {}, "events": {}, "commands": {}, "scope": {} },
    "button": { "props": {}, "events": { "click": {} }, "commands": {}, "scope": {} },
    "mesh-each": {
      "props": { "items": { "type": { "kind": "list", "element": { "kind": "any" } }, "required": true }, "as": { "type": { "kind": "string" }, "required": true }, "key": { "type": { "kind": "any" }, "required": true } },
      "events": {}, "commands": {}, "scope": {}
    },
    "list": {
      "props": {}, "events": {},
      "commands": { "select": { "parameters": [{ "name": "id", "type": { "kind": "string" } }] } },
      "scope": {
        "title": { "kind": "string" },
        "items": { "kind": "list", "element": { "kind": "record", "fields": { "id": { "type": { "kind": "string" }, "required": true }, "title": { "type": { "kind": "string" }, "required": true } } } }
      }
    },
    "detail": {
      "props": {}, "events": {},
      "commands": { "reload": { "parameters": [] }, "back": { "parameters": [] } },
      "scope": { "title": { "kind": "string" }, "heading": { "kind": "string" }, "status": { "kind": "string" } }
    }
  }
}
