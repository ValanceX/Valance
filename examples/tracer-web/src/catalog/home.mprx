<page title={title}>
  <text>{count} items: {summary}</text>
  <button on.click={open(firstId)}>Open first</button>
  <button on.click={reverse()}>Reverse</button>
  {#each items as item (item.id)}
    <row>
      <text>{item.name}</text>
      <button on.click={open(item.id)}>Open</button>
    </row>
  {/each}
</page>
