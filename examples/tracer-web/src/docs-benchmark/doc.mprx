<shell>
  <header>
    <heading>{site}</heading>
    <field value={query} on.input={search($event)} />
    {#if search.status == "loading"}<text>Searching…</text>{/if}
    {#if search.status == "failed"}<text>Search failed: {search.message}</text>{/if}
    {#if search.empty}<text>No results</text>{/if}
    <list>
      {#each search.results as r (r.id)}
        <item><link href={r.href}>{r.label}</link></item>
      {/each}
    </list>
  </header>
  <nav>
    <list>
      {#each nav as n (n.id)}
        <item><text>{n.mark}</text><link href={n.href}>{n.label}</link></item>
      {/each}
    </list>
  </nav>
  <main>
    <heading>{title}</heading>
    {#each paragraphs as p (p.id)}<para>{p.text}</para>{/each}
    {#if code != ""}<code>{code}</code>{/if}
    <button on.click={toggle()}>{detailsLabel}</button>
    {#if detailsOpen}
      <shell>
        <para>{details}</para>
        {#if code != ""}<text>This page has an example.</text>{/if}
      </shell>
    {/if}
    <nav>
      {#if prev.href != ""}<link href={prev.href}>{prev.label}</link>{/if}
      {#if next.href != ""}<link href={next.href}>{next.label}</link>{/if}
    </nav>
  </main>
  <footer><text>Valance documentation benchmark</text></footer>
</shell>
