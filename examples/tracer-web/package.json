{
  "name": "@valancex/tracer-web",
  "version": "0.0.0",
  "private": true,
  "description": "VALANCE's contract test suite: tripwire tests (Node, jsdom, real Chromium) and small fixture applications through @valancex/valance, NEXUS, MESH and PORT Web. For a model application see examples/docs-site.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:browser": "vitest run -c vitest.browser.config.ts",
    "test:bfcache": "vitest run -c vitest.bfcache.config.ts",
    "build:page": "vite build -c vite.page.config.ts",
    "test:smoke": "vitest run -c vitest.smoke.config.ts",
    "build:server": "tsc -p tsconfig.server.json && cp src/*.mprx src/components.json dist/server/",
    "serve:page": "node dist/server/serve-main.js"
  },
  "dependencies": {
    "@valancex/valance": "workspace:*"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.0.0",
    "@valancex/mesh-compiler": "^0.10.0",
    "@valancex/mesh-runtime": "^0.10.0",
    "@valancex/nexus": "^0.12.0",
    "@valancex/port-web": "^0.4.0",
    "@vitest/browser": "3.2.7",
    "effect": "^3.10.0",
    "jsdom": "^26.0.0",
    "playwright": "1.56.1",
    "typescript": "^5.6.0",
    "vite": "7.3.6",
    "vitest": "^3.2.0"
  }
}
