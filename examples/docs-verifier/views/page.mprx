<layout site={site} home={home} theme={theme} menu={menu} query={query} layout={layout} lang={lang} ui={ui} showNav={showNav} hasHeader={hasHeader} header={header} footer={footer} hasLocales={hasLocales} locales={locales} hasVersions={hasVersions} versions={versions} on.toggleMenu={toggleMenu()} on.setTheme={setTheme($event)} on.search={search($event)}>
  <mesh-fill slot="search"><mesh-if when={searching}><panel class="results" role="region" label={ui.search}>
    <live class="results-status" role="status" live="polite">{status}</live>
    <list class="hits"><mesh-each items={hits} as="h" key={h.id}><item><navLink class="hit" href={h.href} current="false"><span class="hit-title">{h.title}</span><span class="hit-where">{h.where}</span><span class="hit-excerpt">{h.excerpt}</span></navLink></item></mesh-each></list>
  </panel></mesh-if></mesh-fill>
  <mesh-fill slot="nav"><mesh-if when={showNav}><nav class="sidebar" label={ui.documentation}>
    <mesh-each items={sections} as="s" key={s.id}>
      <section>
        <mesh-if when={s.title != ""}><para class="nav-title">{s.title}</para></mesh-if>
        <list class="nav-list">
          <mesh-each items={s.items} as="n" key={n.id}>
            <item><navLink class="nav-link" href={n.href} current={n.current}>{n.label}</navLink></item>
          </mesh-each>
        </list>
      </section>
    </mesh-each>
  </nav></mesh-if></mesh-fill>
  <mesh-fill slot="toc"><mesh-if when={hasToc}><nav class="toc" label={ui.onThisPage}>
    <para class="toc-title">{ui.onThisPage}</para>
    <list class="toc-list"><mesh-each items={toc} as="h" key={h.id}><item><navLink class={h.cls} href={h.href} current={h.current}>{h.label}</navLink></item></mesh-each></list>
  </nav></mesh-if></mesh-fill>
  <main id="content" tabindex="-1" busy={loading} status={contentStatus}>
    <mesh-if when={post.show}><post-meta post={post} /></mesh-if>
    <mesh-each items={blocks} as="b" key={b.id}>
      <block b={b} on.copy={copyCode($event)} on.choose={selectTab($event)} />
    </mesh-each>
    <mesh-if when={hasPager}><nav class="pager" label={ui.previousAndNext}>
      <mesh-if when={prev.href != ""}><navLink class="pager-link" href={prev.href} current="false">{prev.label}</navLink></mesh-if>
      <mesh-if when={next.href != ""}><navLink class="pager-link" href={next.href} current="false">{next.label}</navLink></mesh-if>
    </nav></mesh-if>
  </main>
</layout>
