<layout site={site}>
  <mesh-fill slot="nav"><nav>
    <list>
      <mesh-each items={nav} as="n" key={n.id}>
        <item><link href={n.href}>{n.label}</link></item>
      </mesh-each>
    </list>
  </nav></mesh-fill>
  <main>
    <mesh-each items={blocks} as="b" key={b.id}>
      <block kind={b.kind} text={b.text} spans={b.spans} level={b.level} lang={b.lang} tone={b.tone} blockId={b.id} copyLabel={b.copyLabel} on.copy={copyCode($event)} />
    </mesh-each>
    <nav>
      <mesh-if when={prev.href != ""}><link href={prev.href}>{prev.label}</link></mesh-if>
      <mesh-if when={next.href != ""}><link href={next.href}>{next.label}</link></mesh-if>
    </nav>
  </main>
</layout>
