{
  "compilerOptions": {
    "types": [
      "node"
    ],
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true
  },
  "include": [
    "src",
    "build",
    "tests",
    "scripts",
    "sites",
    "vite.config.ts",
    "vitest.config.ts",
    "vitest.smoke.config.ts",
    "vitest.principles.config.ts",
    "vitest.budget.config.ts",
    "vitest.visual.config.ts"
  ]
}
