{
  "name": "@valancex/docs-verifier",
  "version": "0.0.0",
  "private": true,
  "description": "The features verifier: a documentation site built on the development branches of MESH and PORT, to find where composing an application is still a chore. Not a model application; see README.md.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:smoke": "vitest run -c vitest.smoke.config.ts",
    "build:server": "tsc -p tsconfig.server.json && node scripts/copy-views.mjs",
    "build:content": "pnpm build:server && node dist/server/tooling/build-content.js",
    "build:program": "node dist/server/web/build-program.js",
    "build:page": "vite build -c vite.page.config.ts && node scripts/finish-build.mjs",
    "build:all": "node scripts/build-all.mjs",
    "build:site": "node dist/server/web/export-main.js",
    "build": "pnpm build:content && pnpm build:program && pnpm build:page && pnpm build:site",
    "start": "node dist/server/web/serve-main.js",
    "start:ssr": "node dist/server/web/serve-main.js --ssr",
    "test:budget": "vitest run -c vitest.budget.config.ts",
    "test:principles": "vitest run -c vitest.principles.config.ts",
    "test:visual": "vitest run -c vitest.visual.config.ts"
  },
  "dependencies": {
    "@valancex/valance": "0.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@valancex/mesh-compiler": "0.10.0",
    "@valancex/mesh-runtime": "0.10.0",
    "@valancex/nexus": "0.12.2",
    "@valancex/port-web": "0.4.1",
    "effect": "^3.10.0",
    "playwright": "1.56.1",
    "typescript": "^5.6.0",
    "vite": "7.3.6",
    "vitest": "^3.2.0",
    "jsdom": "^26.0.0",
    "@types/jsdom": "^21.1.7",
    "axe-core": "^4.10.0",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "@types/pngjs": "^6.0.5"
  }
}
