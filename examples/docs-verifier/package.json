{
  "name": "@valancex/docs-verifier",
  "version": "0.0.0",
  "private": true,
  "description": "The features verifier: a documentation site built on the development branches of MESH and PORT, to find where composing an application is still a chore. Not a model application; see README.md.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:smoke": "vitest run -c vitest.smoke.config.ts",
    "build:content": "tsc -p tsconfig.server.json && node dist/server/tooling/build-content.js",
    "build": "pnpm build:content && vite build -c vite.page.config.ts && node scripts/copy-views.mjs",
    "start": "node dist/server/web/serve-main.js"
  },
  "dependencies": {
    "@valancex/valance": "0.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@valancex/mesh-compiler": "link:../../../Mesh/packages/mesh-compiler",
    "@valancex/mesh-runtime": "link:../../../Mesh/packages/mesh-runtime",
    "@valancex/nexus": "0.12.0",
    "@valancex/port-web": "link:../../../Port/packages/port-web",
    "effect": "^3.10.0",
    "playwright": "1.56.1",
    "typescript": "^5.6.0",
    "vite": "7.3.6",
    "vitest": "^3.2.0",
    "jsdom": "^26.0.0",
    "@types/jsdom": "^21.1.7"
  },
  "pnpm": {
    "overrides": {
      "@valancex/mesh-runtime": "link:../../../Mesh/packages/mesh-runtime",
      "@valancex/mesh-compiler": "link:../../../Mesh/packages/mesh-compiler",
      "@valancex/port-web": "link:../../../Port/packages/port-web"
    }
  }
}
