<div class="post-meta">
  <time class="post-date" datetime={post.iso}>{post.date}</time>
  {#if post.hasAuthor}<span class="post-author">{post.byline}</span>{/if}
  {#if post.hasTags}<list class="tags">{#each post.tags as t (t.id)}<item><navLink class="tag" href={t.href} current="false">{t.label}</navLink></item>{/each}</list>{/if}
</div>
