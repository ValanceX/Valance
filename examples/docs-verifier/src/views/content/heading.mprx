<mesh-fragment>
  {#if level == 1}<h1 id={anchor}><runs spans={spans} /></h1>{:else if level == 2}<h2 id={anchor}><runs spans={spans} /><anchorLink class="anchor" href={hash} label={linkLabel}>#</anchorLink></h2>{:else}<h3 id={anchor}><runs spans={spans} /><anchorLink class="anchor" href={hash} label={linkLabel}>#</anchorLink></h3>{/if}
</mesh-fragment>
