<div class="tabs">
  <tablist class="tab-list" role="tablist" label={label}>
    {#each tabs as t (t.id)}
      <tab class="tab" role="tab" selected={t.selected} on.click={choose(t.key)}>{t.label}</tab>
    {/each}
  </tablist>
  {#each panels as t (t.id)}
    <tabpanel class="tab-panel" role="tabpanel"><code-block title="" tokens={t.tokens} blockId={t.id} copyLabel={t.copyLabel} on.copy={copy($event)} /></tabpanel>
  {/each}
</div>
