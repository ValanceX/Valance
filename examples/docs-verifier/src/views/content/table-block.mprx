<scroller class="table-wrap" tabindex="0">
  <table class="table">
    <thead>
      <tr>{#each head as c (c.id)}<th align={c.align} scope="col"><runs spans={c.spans} /></th>{/each}</tr>
    </thead>
    <tbody>
      {#each rows as r (r.id)}
        <tr>{#each r.cells as c (c.id)}<td align={c.align}><runs spans={c.spans} /></td>{/each}</tr>
      {/each}
    </tbody>
  </table>
</scroller>
