<layout site={site} home={home} theme={theme} menu={menu} query={query} layout={layout} lang={lang} ui={ui} showNav={showNav} hasHeader={hasHeader} header={header} footer={footer} hasLocales={hasLocales} locales={locales} hasVersions={hasVersions} versions={versions} on.toggleMenu={toggleMenu()} on.setTheme={setTheme($event)} on.search={search($event)}>
  <mesh-fill slot="search">{#if searching}<panel class="results" role="region" label={ui.search}>
    <live class="results-status" role="status" live="polite">{status}</live>
    <list class="hits">{#each hits as h (h.id)}<listitem><navLink class="hit" href={h.href} current="false"><span class="hit-title">{h.title}</span><span class="hit-where">{h.where}</span><span class="hit-excerpt">{h.excerpt}</span></navLink></listitem>{/each}</list>
  </panel>{/if}</mesh-fill>
  <mesh-fill slot="nav">{#if showNav}<nav class="sidebar" label={ui.documentation}>
    {#each sections as s (s.id)}
      <section>
        {#if s.title != ""}<paragraph class="nav-title">{s.title}</paragraph>{/if}
        <list class="nav-list">
          {#each s.items as n (n.id)}
            <listitem><navLink class="nav-link" href={n.href} current={n.current}>{n.label}</navLink></listitem>
          {/each}
        </list>
      </section>
    {/each}
  </nav>{/if}</mesh-fill>
  <mesh-fill slot="toc">{#if hasToc}<nav class="toc" label={ui.onThisPage}>
    <paragraph class="toc-title">{ui.onThisPage}</paragraph>
    <list class="toc-list">{#each toc as h (h.id)}<listitem><navLink class={h.cls} href={h.href} current={h.current}>{h.label}</navLink></listitem>{/each}</list>
  </nav>{/if}</mesh-fill>
  <main id="content" tabindex="-1" busy={loading} status={contentStatus}>
    {#if post.show}<post-meta post={post} />{/if}
    {#each blocks as b (b.id)}
      <block b={b} on.copy={copyCode($event)} on.choose={selectTab($event)} />
    {/each}
    {#if hasPager}<nav class="pager" label={ui.previousAndNext}>
      {#if prev.href != ""}<navLink class="pager-link" href={prev.href} current="false">{prev.label}</navLink>{/if}
      {#if next.href != ""}<navLink class="pager-link" href={next.href} current="false">{next.label}</navLink>{/if}
    </nav>{/if}
  </main>
</layout>
