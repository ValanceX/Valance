<div class="order-detail">
  {#if detailPhase == "loading"}<para class="state">Loading order…</para>{/if}
  {#if detailPhase == "failed"}<para class="state failure">This order could not be loaded.</para>{/if}
  {#if detailPhase == "ready"}
    <h2 id="order">Order {detail.id}: {detail.customer}</h2>
    <para class="total">Total {detail.total}</para>
    <para class="current">Status: <span class="now">{detail.status}</span></para>
    <radiogroup class="choices" label="Status">
      <label><radio name="status" value="open" checked={choice == "open"} on.select={choose($event)} />Open</label>
      <label><radio name="status" value="paid" checked={choice == "paid"} on.select={choose($event)} />Paid</label>
      <label><radio name="status" value="shipped" checked={choice == "shipped"} on.select={choose($event)} />Shipped</label>
    </radiogroup>
    <button class="save" disabled={!changed || saving} on.click={saveStatus()}>{saving ? "Saving…" : "Save status"}</button>
    {#if saveError != ""}<para class="state failure" id="save-error">{saveError}</para>{/if}
  {/if}
</div>
