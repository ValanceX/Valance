{
  "name": "@valancex/todo",
  "version": "0.0.0",
  "private": true,
  "description": "A to-do application written once against its own screen vocabulary: lists, items, routes and guards, with no browser in it. The first desktop target draws it.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json && node dist/build.js",
    "start": "node dist/main.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@valancex/common": "workspace:*",
    "@valancex/router": "workspace:*",
    "@valancex/valance": "workspace:*"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@valancex/mesh-compiler": "^0.17.0",
    "@valancex/mesh-runtime": "^0.17.0",
    "@valancex/nexus": "^0.16.0",
    "@valancex/port-web": "^0.14.0",
    "effect": "^3.10.0",
    "esbuild": "0.28.2",
    "jsdom": "^30.1.3",
    "postject": "1.0.0-alpha.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
