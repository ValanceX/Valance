<column>
  <heading>Edit item</heading>
  <text>In {listName}</text>
  <textfield value={value} placeholder="What needs doing?" on.change={setDraft($event)} />
  {#if dirty}
    <text>Unsaved changes</text>
  {/if}
  <row>
    <button on.click={saveItem()}>Save</button>
    <button on.click={discard()} disabled={clean}>Discard</button>
    <button on.click={go(listHref)}>Back to list</button>
  </row>
</column>
