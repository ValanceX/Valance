<column>
  <heading>Rename list</heading>
  <textfield value={value} placeholder="List name" on.change={setDraft($event)} />
  {#if dirty}
    <text>Unsaved changes</text>
  {/if}
  <row>
    <button on.click={saveList()}>Save</button>
    <button on.click={discard()} disabled={clean}>Discard</button>
    <button on.click={go(listHref)}>Back to list</button>
  </row>
</column>
