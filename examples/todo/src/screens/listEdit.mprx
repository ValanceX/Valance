<window title="Rename list">
  <column>
    <heading>Rename list</heading>
    <field value={value} placeholder="List name" on.change={setDraft($event)} />
    {#if dirty}
      <text>Unsaved changes</text>
    {/if}
    <row>
      <button on.press={saveList()}>Save</button>
      <button on.press={discard()} disabled={clean}>Discard</button>
      <button on.press={go(listHref)}>Back to list</button>
    </row>
  </column>
</window>
