{
  "name": "@valancex/router",
  "version": "0.13.0",
  "description": "Routing for VALANCE applications: route definitions with typed path and query parameters, matching conditions, guards for entering and leaving a route, programmatic navigation, and a title per route. Plugs into Web.run as the URL policy.",
  "keywords": [
    "valance",
    "router",
    "routes",
    "guards"
  ],
  "homepage": "https://github.com/ValanceX/Valance/tree/main/packages/router#readme",
  "bugs": {
    "url": "https://github.com/ValanceX/Valance/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ValanceX/Valance.git",
    "directory": "packages/router"
  },
  "license": "MIT",
  "author": "Jack Miller <jackmiller0899@gmail.com>",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "prepack": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@valancex/nexus": "^0.14.0 || ^0.15.0 || ^0.16.0"
  },
  "peerDependencies": {
    "@valancex/valance": "^0.12.0",
    "effect": "^3.10.0"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.0.0",
    "@valancex/mesh-compiler": "^0.17.0",
    "@valancex/mesh-runtime": "^0.17.0",
    "@valancex/port-web": "^0.14.0",
    "@valancex/valance": "workspace:^",
    "effect": "^3.10.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0"
  }
}
