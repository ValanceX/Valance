    },
    "em": {
      "primitive": "emphasis",
      "element": "em"
    },
    "span": {
      "primitive": "span",
      "element": "span",
      "props": {
        "class": {
          "kind": "attribute",
          "name": "class"
        }
      }
    },
    "image": {
      "primitive": "image",
      "element": "img",
      "props": {
        "class": {
          "kind": "attribute",
          "name": "class"
        },
        "src": {
          "kind": "attribute",
          "name": "src"
        },
        "alt": {
          "kind": "attribute",
          "name": "alt"
        },
        "loading": {
          "kind": "attribute",
          "name": "loading"
        }
      },
      "rename": {
        "label": "alt"
      }
    },
    "a": {
      "primitive": "a",
      "element": "a",
      "props": {
        "href": {
          "kind": "attribute",
          "name": "href"
        }
      }
    },
    "link": {
      "primitive": "link",
      "element": "a",
      "props": {
        "href": {
          "kind": "attribute",
          "name": "href"
        },
        "class": {
          "kind": "attribute",
          "name": "class"
        },
        "current": {
          "kind": "attribute",
          "name": "aria-current"
        }
      }
    },
    "checkbox": {
      "primitive": "checkbox",
      "element": "input",
      "attributes": {
        "type": "checkbox"
      },
      "props": {
        "checked": {
          "kind": "controlled-boolean",
          "name": "checked"
        },
        "label": {
          "kind": "attribute",
          "name": "aria-label"
        },
        "invalid": {
          "kind": "attribute",
          "name": "aria-invalid"
        },
        "describedby": {
          "kind": "attribute",
          "name": "aria-describedby"
        }
      },
      "events": {
        "change": {
          "type": "change",
          "payload": {
            "kind": "boolean",
            "of": "checked"
          }
        }
      }
    },
    "textfield": {
      "primitive": "textfield",
      "element": "input",
      "props": {
        "value": {
          "kind": "controlled",
          "name": "value"
        },
        "placeholder": {
          "kind": "attribute",
          "name": "placeholder"
        },
        "label": {
          "kind": "attribute",
          "name": "aria-label"
        },
        "kind": {
          "kind": "attribute",
          "name": "type"
        },
        "invalid": {
          "kind": "attribute",
          "name": "aria-invalid"
        },
        "describedby": {
          "kind": "attribute",
          "name": "aria-describedby"
        }
      },
      "events": {
        "change": {
          "type": "input",
          "payload": {
            "kind": "string",
            "of": "value"
          }
        },
        "submit": {
          "type": "keydown",
          "key": "Enter"
        },
        "cancel": {
          "type": "keydown",
          "key": "Escape"
        },
        "focus": {
          "type": "focus"
        },
        "blur": {
          "type": "blur"
        }
      }
    },
    "button": {
      "primitive": "button",
      "element": "button",
      "props": {
        "class": {
          "kind": "attribute",
          "name": "class",
          "optional": true
        },
        "pressed": {
          "kind": "attribute",
          "name": "aria-pressed",
          "optional": true
        },
        "label": {
          "kind": "attribute",
          "name": "aria-label"
        },
        "disabled": {
          "kind": "boolean-attribute",
          "name": "disabled"
        }
      },
      "events": {
        "click": {
          "type": "click"
        }
      }
    },
    "radiogroup": {
      "primitive": "radiogroup",
      "element": "div",
      "attributes": {
        "role": "radiogroup"
      },
      "props": {
        "label": {
          "kind": "attribute",
          "name": "aria-label"
        },
        "invalid": {
          "kind": "attribute",
          "name": "aria-invalid"
        },
        "describedby": {
          "kind": "attribute",
          "name": "aria-describedby"
        }
      }
    },
    "radio": {
      "primitive": "radio",
      "element": "input",
      "attributes": {
        "type": "radio"
      },
      "props": {
        "checked": {
          "kind": "controlled-boolean",
          "name": "checked"
        },
        "value": {
          "kind": "attribute",
          "name": "value"
        },
        "label": {
          "kind": "attribute",
          "name": "aria-label"
        },
        "disabled": {
          "kind": "boolean-attribute",
          "name": "disabled"
        }
      },
      "events": {
        "select": {
          "type": "change",
          "payload": {
            "kind": "string",
            "of": "value"
          }
        }
      }
    },
    "status": {
      "primitive": "status",
      "element": "div",
      "attributes": {
        "role": "status"
      }
    },
    "alert": {
      "primitive": "alert",
      "element": "div",
      "attributes": {
        "role": "alert"
      }
    },
    "label": {
