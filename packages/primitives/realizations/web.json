{
  "version": 1,
  "target": "web",
  "note": "How the web realizes each primitive: the template's tag, the element, the constant attributes and how each prop and event is realized (the shapes of @valancex/port-web). `primitive` joins a tag to its specification. A prop marked `optional` is optional on the web only (a styling or accessibility hook); `fixed` props are chosen by the tag; `rename` maps a portable prop to the web's name for it. Event payloads name an extractor (`checked`, `value`): data, not code.",
  "primitives": {
    "column": {
      "primitive": "column",
      "element": "vlx-column"
    },
    "row": {
      "primitive": "row",
      "element": "vlx-row"
    },
    "heading": {
      "primitive": "heading",
      "element": "h2",
      "props": {
        "level": {
          "kind": "attribute",
          "name": "aria-level"
        }
      }
    },
    "text": {
      "primitive": "text",
      "element": "span",
      "props": {
        "id": {
          "kind": "attribute",
          "name": "id"
        }
      }
    },
    "shell": {
      "primitive": "shell",
      "element": "div",
      "props": {
        "class": {
          "kind": "attribute",
          "name": "class"
        },
        "theme": {
          "kind": "attribute",
          "name": "data-theme"
        }
      }
    },
    "div": {
      "primitive": "div",
      "element": "div",
      "props": {
        "class": {
          "kind": "attribute",
          "name": "class"
        }
      }
    },
    "header": {
      "primitive": "header",
