        }
      }
    },
    "olist": {
      "primitive": "list",
      "element": "ol",
      "props": {
        "class": {
          "kind": "attribute",
          "name": "class"
        }
      },
      "fixed": {
        "ordered": true
      }
    },
    "item": {
      "primitive": "listitem",
      "element": "li"
    },
    "pre": {
      "primitive": "pre",
      "element": "pre",
      "props": {
        "class": {
          "kind": "attribute",
          "name": "class"
        },
        "tabindex": {
          "kind": "attribute",
          "name": "tabindex"
        }
      }
    },
    "code": {
