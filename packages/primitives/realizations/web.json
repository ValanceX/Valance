          "name": "tabindex"
        }
      }
    },
    "nav": {
      "primitive": "nav",
      "element": "nav",
      "props": {
        "class": {
          "kind": "attribute",
          "name": "class"
        },
        "label": {
          "kind": "attribute",
          "name": "aria-label"
        }
      }
    },
    "aside": {
      "primitive": "aside",
      "element": "aside",
      "props": {
        "class": {
          "kind": "attribute",
