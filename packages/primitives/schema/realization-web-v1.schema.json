{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://valancex.dev/schema/realization-web-v1.json",
  "title": "The web's realization of the primitives (realization-web-v1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "target",
    "primitives"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "target": {
      "const": "web"
    },
    "note": {
      "type": "string"
    },
    "renamed": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "primitives": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "primitive",
          "element"
        ],
        "properties": {
          "primitive": {
            "type": "string"
          },
          "element": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "attributes": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "group": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "within",
              "attribute"
            ],
            "properties": {
              "within": {
                "type": "string",
                "minLength": 1
              },
              "attribute": {
                "type": "string",
                "pattern": "^[a-z_:][a-z0-9_.:-]*$"
              }
            }
          },
          "props": {
            "type": "object",
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "name"
                  ],
                  "properties": {
                    "kind": {
                      "enum": [
                        "attribute",
                        "text-property",
                        "controlled",
                        "boolean-attribute",
                        "controlled-boolean",
                        "element",
                        "layer"
                      ]
                    },
                    "name": {
                      "type": "string"
                    },
                    "optional": {
                      "type": "boolean"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "name",
                    "holds"
                  ],
                  "properties": {
                    "kind": {
                      "const": "property"
                    },
                    "name": {
                      "type": "string"
                    },
                    "holds": {
                      "enum": [
                        "boolean",
                        "number",
                        "value"
                      ]
                    },
                    "optional": {
                      "type": "boolean"
                    }
                  }
                }
              ]
            }
          },
          "events": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "type": "string"
                },
                "key": {
                  "type": "string"
                },
                "payload": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "of"
                  ],
                  "properties": {
                    "kind": {
                      "enum": [
                        "string",
                        "number",
                        "boolean"
                      ]
                    },
                    "of": {
                      "enum": [
                        "checked",
                        "value",
                        "notPressed"
                      ]
                    }
                  }
                },
                "raised": {
                  "const": true
                }
              }
            }
          },
          "fixed": {
            "type": "object"
          },
          "rename": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "style": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "states": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            }
          },
          "layer": {
            "enum": [
              "modal",
              "popover"
            ]
          }
        }
      }
    },
    "renamedProps": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      }
    }
  }
}
