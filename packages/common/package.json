{
  "name": "@valancex/common",
  "version": "0.1.0",
  "description": "The author's side of a VALANCE application: defineApp, component and field. What src/main.ts imports; the vlx command (@valancex/cli) builds what it describes.",
  "keywords": [
    "valance",
    "defineApp",
    "component"
  ],
  "homepage": "https://github.com/ValanceX/Valance/tree/main/packages/common#readme",
  "bugs": {
    "url": "https://github.com/ValanceX/Valance/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ValanceX/Valance.git",
    "directory": "packages/common"
  },
  "license": "MIT",
  "author": "Jack Miller <jackmiller0899@gmail.com>",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "types"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "prepack": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@valancex/valance": "workspace:^"
  },
  "peerDependencies": {
    "effect": "^3.10.0"
  },
  "devDependencies": {
    "effect": "^3.10.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0"
  }
}
