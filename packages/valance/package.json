{
  "name": "@valancex/valance",
  "version": "0.15.0",
  "description": "VALANCE application composition: starts a NEXUS application, renders it with MESH, and realizes it on a PORT target.",
  "type": "module",
  "license": "MIT",
  "author": "Jack Miller <jackmiller0899@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ValanceX/Valance.git",
    "directory": "packages/valance"
  },
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "default": "./dist/web.js"
    },
    "./web/server": {
      "types": "./dist/web-server.d.ts",
      "default": "./dist/web-server.js"
    },
    "./web/plugin": {
      "types": "./dist/web-plugin.d.ts",
      "default": "./dist/web-plugin.js"
    },
    "./web/build": {
      "types": "./dist/web-manifest.d.ts",
      "default": "./dist/web-manifest.js"
    },
    "./generate": {
      "types": "./dist/generate.d.ts",
      "default": "./dist/generate.js"
    },
    "./replay": {
      "types": "./dist/replay.d.ts",
      "default": "./dist/replay.js"
    },
    "./native": {
      "types": "./dist/native.d.ts",
      "default": "./dist/native.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "default": "./dist/internal.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@valancex/nexus": "^0.14.0 || ^0.15.0 || ^0.16.0"
  },
  "peerDependencies": {
    "@valancex/mesh-compiler": "^0.17.0",
    "@valancex/mesh-runtime": "^0.15.0 || ^0.16.0 || ^0.17.0",
    "@valancex/port-web": "^0.10.0 || ^0.11.0 || ^0.12.0 || ^0.13.0 || ^0.14.0",
    "effect": "^3.10.0"
  },
  "peerDependenciesMeta": {
    "@valancex/mesh-compiler": {
      "optional": true
    },
    "@valancex/port-web": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@valancex/mesh-compiler": "^0.17.0",
    "@valancex/mesh-runtime": "^0.17.0",
    "@valancex/port-web": "^0.14.0",
    "effect": "^3.10.0",
    "esbuild": "0.28.2",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0"
  }
}
