{
  "name": "@valancex/valance",
  "version": "0.2.0",
  "description": "VALANCE application composition: starts a NEXUS application, renders it with MESH, and realizes it on a PORT target.",
  "type": "module",
  "license": "MIT",
  "author": "Jack Miller <jackmiller0899@gmail.com>",
  "repository": { "type": "git", "url": "git+https://github.com/ValanceX/Valance.git", "directory": "packages/valance" },
  "engines": { "node": ">=22" },
  "sideEffects": false,
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./web": { "types": "./dist/web.d.ts", "default": "./dist/web.js" },
    "./web/server": { "types": "./dist/web-server.d.ts", "default": "./dist/web-server.js" },
    "./internal": { "types": "./dist/internal.d.ts", "default": "./dist/internal.js" },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@valancex/nexus": "^0.10.1"
  },
  "peerDependencies": {
    "@valancex/mesh-runtime": "^0.7.0",
    "@valancex/port-web": "^0.2.2",
    "effect": "^3.10.0"
  },
  "peerDependenciesMeta": {
    "@valancex/port-web": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@valancex/mesh-runtime": "^0.7.0",
    "@valancex/port-web": "^0.2.2",
    "effect": "^3.10.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0"
  }
}
