{
  "version": 1,
  "target": {
    "primitive": "checkbox",
    "part": "root"
  },
  "base": {
    "min-size": "space.5"
  },
  "states": {
    "focus-visible": {
      "outline": {
        "width": "border.2",
        "color": "color.focus",
        "offset": "space.1"
      }
    },
    "invalid": {
      "outline": {
        "width": "border.2",
        "color": "color.danger",
        "offset": "space.1"
      }
    }
  }
}
