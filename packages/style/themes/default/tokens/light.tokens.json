{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "The light mode: the color roles. Mode-independent tokens (space, radius, border width, type) are in base.tokens.json.",
  "color": {
    "$type": "color",
    "text": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.1137,
          0.1373,
          0.1882
        ],
        "hex": "#1d2330"
      },
      "$description": "Body text and the text of controls."
    },
    "text-muted": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.3098,
          0.3451,
          0.4392
        ],
        "hex": "#4f5870"
      },
      "$description": "Secondary text."
    },
    "surface": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1.0,
          1.0,
          1.0
        ],
        "hex": "#ffffff"
      },
      "$description": "The page and the surface of a control."
    },
    "surface-field": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1.0,
          1.0,
          1.0
        ],
        "hex": "#ffffff"
      },
      "$description": "The inside of a text field."
    },
    "border": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.4196,
          0.451,
          0.5216
        ],
        "hex": "#6b7385"
      },
      "$description": "The edge of a control, which must be seen against the surface."
    },
    "accent": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.2902,
          0.1843,
          0.7529
        ],
        "hex": "#4a2fc0"
      },
      "$description": "The surface of a primary control."
    },
    "on-accent": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1.0,
          1.0,
          1.0
        ],
        "hex": "#ffffff"
      },
      "$description": "Text on the accent."
    },
    "danger": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.702,
          0.149,
          0.1176
        ],
        "hex": "#b3261e"
      },
      "$description": "The surface of a control that destroys."
    },
    "on-danger": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1.0,
          1.0,
          1.0
        ],
        "hex": "#ffffff"
      },
      "$description": "Text on the danger color."
    },
    "focus": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.102,
          0.3373,
          0.8588
        ],
        "hex": "#1a56db"
      },
      "$description": "The focus ring."
    }
  }
}
