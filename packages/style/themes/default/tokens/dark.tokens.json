{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "The dark mode: the color roles. Mode-independent tokens (space, radius, border width, type) are in base.tokens.json.",
  "color": {
    "$type": "color",
    "text": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.9098,
          0.9176,
          0.9451
        ],
        "hex": "#e8eaf1"
      },
      "$description": "Body text and the text of controls."
    },
    "text-muted": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.6588,
          0.6902,
          0.7686
        ],
        "hex": "#a8b0c4"
      },
      "$description": "Secondary text."
    },
    "surface": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.0706,
          0.0784,
          0.1059
        ],
        "hex": "#12141b"
      },
      "$description": "The page and the surface of a control."
    },
    "surface-field": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.1059,
          0.1176,
          0.1608
        ],
        "hex": "#1b1e29"
      },
      "$description": "The inside of a text field."
    },
    "border": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.5529,
          0.5882,
          0.6706
        ],
        "hex": "#8d96ab"
      },
      "$description": "The edge of a control, which must be seen against the surface."
    },
    "accent": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.6549,
          0.5451,
          0.9804
        ],
        "hex": "#a78bfa"
      },
      "$description": "The surface of a primary control."
    },
    "on-accent": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.0706,
          0.0784,
          0.1059
        ],
        "hex": "#12141b"
      },
      "$description": "Text on the accent."
    },
    "danger": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.949,
          0.7216,
          0.7098
        ],
        "hex": "#f2b8b5"
      },
      "$description": "The surface of a control that destroys."
    },
    "on-danger": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.2549,
          0.0549,
          0.0431
        ],
        "hex": "#410e0b"
      },
      "$description": "Text on the danger color."
    },
    "focus": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.5412,
          0.7059,
          1.0
        ],
        "hex": "#8ab4ff"
      },
      "$description": "The focus ring."
    }
  }
}
