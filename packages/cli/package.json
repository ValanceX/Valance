{
  "name": "@valancex/cli",
  "version": "0.16.0",
  "description": "vlx, the VALANCE command: make an application (vlx init), serve it as you edit (vlx dev), build it to a static site (vlx build), check it (vlx check). Content, layout, components and styles in, a website out.",
  "keywords": [
    "valance",
    "cli",
    "vlx",
    "static-site",
    "scaffold"
  ],
  "homepage": "https://github.com/ValanceX/Valance/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/ValanceX/Valance/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ValanceX/Valance.git",
    "directory": "packages/cli"
  },
  "license": "MIT",
  "author": "Jack Miller <jackmiller0899@gmail.com>",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "vlx": "./bin/vlx.js"
  },
  "sideEffects": false,
  "exports": {
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./schemas/*": "./schemas/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "bin",
    "views",
    "views-desktop",
    "schemas",
    "templates"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-data.mjs",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "prepack": "tsc -p tsconfig.json && node scripts/copy-data.mjs"
  },
  "dependencies": {
    "@valancex/common": "workspace:^",
    "@valancex/mesh-compiler": "^0.18.0",
    "@valancex/port-desktop-vocabulary": "^0.12.0 || ^0.13.0 || ^0.14.0",
    "@valancex/style": "workspace:^",
    "@valancex/valance": "workspace:^",
    "effect": "^3.10.0",
    "ink": "7.1.1",
    "postject": "1.0.0-alpha.6",
    "react": "19.3.1",
    "vite": "7.3.6"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "19.3.0",
    "@valancex/mesh-runtime": "^0.18.0",
    "dom-accessibility-api": "^0.7.0",
    "ink-testing-library": "4.0.0",
    "jsdom": "^30.1.3",
    "playwright": "1.64.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "vnu-jar": "^26.10.12"
  }
}
