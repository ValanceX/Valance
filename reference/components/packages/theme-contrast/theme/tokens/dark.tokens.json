{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "color": {
    "$type": "color",
    "text": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1.0,
          1.0,
          1.0
        ],
        "hex": "#ffffff"
      }
    },
    "text-muted": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1.0,
          1.0,
          1.0
        ],
        "hex": "#ffffff"
      }
    },
    "surface": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.0,
          0.0,
          0.0
        ],
        "hex": "#000000"
      }
    },
    "surface-field": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.0,
          0.0,
          0.0
        ],
        "hex": "#000000"
      }
    },
    "border": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1.0,
          1.0,
          1.0
        ],
        "hex": "#ffffff"
      }
    },
    "accent": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1.0,
          0.9333,
          0.0
        ],
        "hex": "#ffee00"
      }
    },
    "on-accent": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.0,
          0.0,
          0.0
        ],
        "hex": "#000000"
      }
    },
    "danger": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1.0,
          0.6196,
          0.6196
        ],
        "hex": "#ff9e9e"
      }
    },
    "on-danger": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.0,
          0.0,
          0.0
        ],
        "hex": "#000000"
      }
    },
    "focus": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1.0,
          0.9333,
          0.0
        ],
        "hex": "#ffee00"
      }
    }
  }
}
