{
  "name": "components",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "check": "pnpm --filter \"./packages/ui\" --filter \"./packages/ui-web\" --filter \"./packages/theme-plain\" --filter \"./packages/theme-contrast\" run check",
    "test": "vitest run",
    "boundary": "node tests/boundary.mjs"
  },
  "description": "The reference component library of VALANCE: five components, two themes, a terminal PORT and a playground, built as an outsider with published packages only.",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@valancex/cli": "^0.16.0",
    "@valancex/mesh-compiler": "^0.18.0",
    "@valancex/mesh-runtime": "^0.18.0",
    "@valancex/port-terminal": "workspace:*",
    "playwright": "1.56.1",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0",
    "vnu-jar": "^26.10.12"
  }
}
